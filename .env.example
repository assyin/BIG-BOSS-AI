# ============================================
# BIG BOSS FITNESS - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ============================================
# DATABASE
# ============================================
BBF_DATABASE_URL=postgresql://bigboss:bigboss_dev_password@localhost:5432/bigbossfitness

# ============================================
# JWT AUTHENTICATION
# ============================================
BBF_JWT_SECRET=your-super-secret-key-minimum-32-characters-long
BBF_JWT_ISSUER=BigBossFitness
BBF_JWT_AUDIENCE=BigBossFitnessApp
BBF_JWT_EXPIRY_MINUTES=15
BBF_JWT_REFRESH_EXPIRY_DAYS=30

# ============================================
# CLAUDE API (Anthropic)
# ============================================
BBF_CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxx
BBF_CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
BBF_CLAUDE_MODEL_SMART=claude-sonnet-4-6

# ============================================
# OPENAI API (GPT - Alternative/Backup)
# ============================================
BBF_OPENAI_API_KEY=sk-xxxxxxxxxxxxx
BBF_OPENAI_MODEL_FAST=gpt-4o-mini
BBF_OPENAI_MODEL_VISION=gpt-4o

# ============================================
# CLOUDFLARE R2 (Video Storage)
# ============================================
BBF_CLOUDFLARE_ACCOUNT_ID=
BBF_CLOUDFLARE_R2_ACCESS_KEY=
BBF_CLOUDFLARE_R2_SECRET_KEY=
BBF_CLOUDFLARE_R2_BUCKET=bigboss-videos
BBF_CLOUDFLARE_R2_PUBLIC_URL=https://videos.bigbossfitness.ma
BBF_CLOUDFLARE_SIGNED_URL_EXPIRY=1800

# ============================================
# ELEVENLABS (Voice Clone)
# ============================================
BBF_ELEVENLABS_API_KEY=
BBF_ELEVENLABS_VOICE_ID=

# ============================================
# SUPABASE
# ============================================
BBF_SUPABASE_URL=https://xxxxx.supabase.co
BBF_SUPABASE_ANON_KEY=
BBF_SUPABASE_SERVICE_KEY=

# ============================================
# FIREBASE (Push Notifications)
# ============================================
BBF_FIREBASE_PROJECT_ID=
BBF_FIREBASE_PRIVATE_KEY=

# ============================================
# REDIS (Cache)
# ============================================
BBF_REDIS_CONNECTION=localhost:6379

# ============================================
# APP SETTINGS
# ============================================
BBF_ENVIRONMENT=Development
BBF_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081
BBF_API_BASE_URL=http://localhost:5000

# ============================================
# RATE LIMITING
# ============================================
BBF_MAX_REQUESTS_PER_MINUTE=100
BBF_MAX_AI_REQUESTS_PER_MINUTE=10

# ============================================
# PAYMENT (Phase 2)
# ============================================
BBF_STRIPE_SECRET_KEY=
BBF_STRIPE_WEBHOOK_SECRET=

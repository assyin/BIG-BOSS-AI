# Google OAuth Client IDs (from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
#
# 1. Create a project in Google Cloud Console
# 2. Enable "Google+ API" or "Google Identity API"
# 3. Create OAuth 2.0 Client IDs for each platform:
#    - Android: requires SHA-1 of your signing key (for EAS build: `eas credentials`)
#      Package name: ma.bigbossfitness.app
#    - iOS: bundle identifier: ma.bigbossfitness.app
#    - Web: used by Expo Go and during dev on the web

EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
